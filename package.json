{
  "name": "ade-runner-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ade/hub --filter @ade/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @ade/shared build && pnpm --filter @ade/runner build && pnpm --filter @ade/web build && pnpm --filter @ade/hub build",
    "test": "vitest run",
    "accept:p0": "pnpm build && tsx scripts/verify/p0-events-append-only.ts && playwright test e2e/p0-smoke.spec.ts",
    "accept:all": "pnpm test && pnpm accept:p0",
    "real:spike-claude": "tsx scripts/real/spike-claude.ts",
    "real:spike-codex": "tsx scripts/real/spike-codex.ts",
    "real:spike-codex-acp": "tsx scripts/real/spike-codex-acp.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.8.6",
    "eslint": "^9.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.4",
    "yaml": "^2.6.0"
  }
}
